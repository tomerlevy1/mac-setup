# Example configuration for mac-setup
# Copy this file to config.sh and edit as needed. This file is ignored by git.

# Your Git user name
# GIT_NAME="Tomer Levy"

# Your Git email
# Prefer GitHub noreply form to keep your real email out of public commit history.
# Find yours at https://github.com/settings/emails (format: <id>+<username>@users.noreply.github.com)
# GIT_EMAIL="38258691+tomerlevy1@users.noreply.github.com"

# Example: Set your preferred default shell (optional, used by interactive script)
# DEFAULT_SHELL="/opt/homebrew/bin/zsh"

# Example: Set a custom Homebrew prefix (if not default)
# HOMEBREW_PREFIX="/opt/homebrew"

# Add any other environment variables you want available to all modules below 
